<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= appName %></title>
    <link rel="stylesheet" href="/styles/site.css" />
  </head>
  <body>
    <div class="backdrop"></div>
    <main class="shell">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Execution workspace</p>
          <h1><%= appName %></h1>
          <p class="lede">Track priorities, keep owners visible, and move work across the board without the bulk of a full project suite.</p>
        </div>
        <div class="hero-side">
          <form method="post" action="/logout" class="session-card">
            <div>
              <p class="eyebrow">Signed in</p>
              <strong><%= currentUser?.username %></strong>
            </div>
            <button type="submit" class="ghost">Logout</button>
          </form>
          <a href="/lessons" class="insight-card insight-card-compact">
            <div>
              <p class="eyebrow">Startup memory</p>
              <h2>Lessons Learned</h2>
            </div>
            <div class="insight-metric">
              <span>Entries</span>
              <strong><%= lessonCount %></strong>
            </div>
          </a>
          <a href="/customers" class="insight-card insight-card-compact">
            <div>
              <p class="eyebrow">Pipeline</p>
              <h2>Customers</h2>
            </div>
            <div class="insight-metric">
              <span>Total</span>
              <strong><%= customerCount %></strong>
            </div>
          </a>
        </div>
      </section>

      <section class="surface-band surface-band-summary">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Summary</p>
            <h2>Execution overview</h2>
          </div>
          <p class="hint">Use the summary tiles to narrow the board to the tasks that need attention first.</p>
        </div>
        <section class="stats" id="stats">
          <button type="button" class="stat-tile is-active" data-stat-filter="total"><span>Total</span><strong><%= summary.total %></strong></button>
          <button type="button" class="stat-tile" data-stat-filter="planned"><span>Planned</span><strong><%= summary.planned %></strong></button>
          <button type="button" class="stat-tile" data-stat-filter="in-progress"><span>In Progress</span><strong><%= summary.inProgress %></strong></button>
          <button type="button" class="stat-tile" data-stat-filter="blocked"><span>Blocked</span><strong><%= summary.blocked %></strong></button>
          <button type="button" class="stat-tile" data-stat-filter="done"><span>Done</span><strong><%= summary.done %></strong></button>
          <button type="button" class="stat-tile" data-stat-filter="overdue"><span>Overdue</span><strong><%= summary.overdue %></strong></button>
        </section>
      </section>

      <section class="surface-band surface-band-work">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Workspace</p>
            <h2>Plan and execute</h2>
          </div>
          <p class="hint">Create tasks on the left, then review, filter, and move active work on the right.</p>
        </div>
        <section class="workspace">
          <section class="composer">
          <div class="panel-head">
            <div>
              <p class="eyebrow">New task</p>
              <h2>Task details</h2>
            </div>
          </div>
          <form id="task-form" class="task-form">
            <input type="hidden" name="id" id="task-id" />
            <label>
              <span>Task title</span>
              <input type="text" name="title" id="title" maxlength="200" required />
            </label>
            <label>
              <span>Description</span>
              <textarea name="description" id="description" rows="4" placeholder="Goal, dependencies, expected outcome"></textarea>
            </label>
            <div class="grid two">
              <label>
                <span>Status</span>
                <select name="status" id="status">
                  <% statuses.forEach((status) => { %>
                    <option value="<%= status %>"><%= status %></option>
                  <% }) %>
                </select>
              </label>
              <label>
                <span>Priority</span>
                <select name="priority" id="priority">
                  <% priorities.forEach((priority) => { %>
                    <option value="<%= priority %>" <%= priority === 'Medium' ? 'selected' : '' %>><%= priority %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <div class="grid two">
              <label>
                <span>Project</span>
                <input type="text" name="project" id="project" maxlength="160" placeholder="Initiative or workstream" />
              </label>
              <label>
                <span>Owner</span>
                <input type="text" name="owner" id="owner" maxlength="120" placeholder="Team member" />
              </label>
            </div>
            <div class="grid two">
              <label>
                <span>Due date</span>
                <input type="date" name="dueDate" id="dueDate" />
              </label>
            </div>
            <div class="form-actions">
              <button type="submit" class="primary">Save task</button>
              <button type="button" class="ghost" id="reset-form">Clear</button>
            </div>
          </form>
        </section>

        <section class="board-panel">
          <div class="panel-head inline">
            <div>
              <p class="eyebrow">Task board</p>
              <h2>Task board</h2>
            </div>
            <div class="board-tools">
              <p class="hint">Review status, filter down quickly, and keep the current workload readable.</p>
              <div class="view-toggle" id="view-toggle">
                <button type="button" class="ghost is-active" data-view="board">Board</button>
                <button type="button" class="ghost" data-view="list">List</button>
              </div>
            </div>
          </div>
          <section class="filters">
            <div class="filters-top">
              <div>
                <p class="eyebrow">Filters</p>
                <h3>Focus the board</h3>
              </div>
              <button type="button" class="ghost" id="clear-filters">Reset filters</button>
            </div>
            <div class="filter-grid">
              <label>
                <span>Search</span>
                <input type="search" id="filter-search" placeholder="Search title or description" />
              </label>
              <label>
                <span>Status</span>
                <select id="filter-status">
                  <option value="">All statuses</option>
                  <% statuses.forEach((status) => { %>
                    <option value="<%= status %>"><%= status %></option>
                  <% }) %>
                </select>
              </label>
              <label>
                <span>Priority</span>
                <select id="filter-priority">
                  <option value="">All priorities</option>
                  <% priorities.forEach((priority) => { %>
                    <option value="<%= priority %>"><%= priority %></option>
                  <% }) %>
                </select>
              </label>
              <label>
                <span>Project</span>
                <select id="filter-project">
                  <option value="">All projects</option>
                </select>
              </label>
              <label>
                <span>Owner</span>
                <select id="filter-owner">
                  <option value="">All owners</option>
                </select>
              </label>
              <label>
                <span>Due state</span>
                <select id="filter-due">
                  <option value="">Any due state</option>
                  <option value="overdue">Overdue</option>
                  <option value="today">Due today</option>
                  <option value="upcoming">Upcoming</option>
                  <option value="none">No due date</option>
                </select>
              </label>
              <label>
                <span>Sort by</span>
                <select id="filter-sort">
                  <option value="updated-desc">Recently updated</option>
                  <option value="due-asc">Due date</option>
                  <option value="priority-desc">Priority</option>
                  <option value="title-asc">Title</option>
                </select>
              </label>
            </div>
            <p class="filter-result" id="filter-result"></p>
          </section>
          <div id="board" class="board"></div>
          <div id="task-list" class="task-list hidden" aria-hidden="true"></div>
          </section>
        </section>
      </section>
    </main>

    <template id="task-card-template">
      <article class="task-card">
        <div class="task-top">
          <span class="priority-pill"></span>
          <div class="task-actions">
            <button class="mini" data-action="comment">Comment</button>
            <button class="mini" data-action="edit">Edit</button>
            <button class="mini danger" data-action="delete">Delete</button>
          </div>
        </div>
        <h3></h3>
        <p class="task-desc"></p>
        <div class="task-comment-wrap">
          <span class="task-comment-label">Latest comment</span>
          <p class="task-comment"></p>
        </div>
        <dl>
          <div><dt>Project</dt><dd class="task-project"></dd></div>
          <div><dt>Owner</dt><dd class="task-owner"></dd></div>
          <div><dt>Due</dt><dd class="task-due"></dd></div>
          <div><dt>Updated</dt><dd class="task-updated"></dd></div>
        </dl>
      </article>
    </template>

    <template id="task-row-template">
      <article class="task-row">
        <div class="task-row-main">
          <div class="task-row-title">
            <h3></h3>
            <p class="task-desc"></p>
            <p class="task-comment"></p>
          </div>
          <div class="task-row-meta">
            <span class="priority-pill"></span>
            <span class="task-project"></span>
            <span class="task-status"></span>
            <span class="task-owner"></span>
            <span class="task-due"></span>
          </div>
        </div>
        <div class="task-actions">
          <button class="mini" data-action="comment">Comment</button>
          <button class="mini" data-action="edit">Edit</button>
          <button class="mini danger" data-action="delete">Delete</button>
        </div>
      </article>
    </template>

    <script>
      window.__TECHZICK__ = {
        statuses: <%- JSON.stringify(statuses) %>,
        priorities: <%- JSON.stringify(priorities) %>
      };
    </script>
    <script id="initial-tasks" type="application/json"><%- JSON.stringify(tasks).replace(/</g, '\\u003c') %></script>
    <script src="/scripts/app.js" defer></script>
  </body>
</html>
