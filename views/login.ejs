<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | <%= appName %></title>
    <link rel="stylesheet" href="/styles/site.css" />
  </head>
  <body>
    <div class="backdrop"></div>
    <main class="login-shell">
      <section class="login-card">
        <div class="login-copy">
          <p class="eyebrow">Authentication required</p>
          <h1><%= appName %></h1>
          <p class="lede">Sign in before viewing the task board or making task changes.</p>
        </div>

        <form method="post" action="/login" class="task-form login-form">
          <input type="hidden" name="next" value="<%= nextPath %>" />
          <label>
            <span>Username</span>
            <input type="text" name="username" value="Kinetriq" autocomplete="username" required />
          </label>
          <label>
            <span>Password</span>
            <input type="password" name="password" autocomplete="current-password" required />
          </label>
          <% if (error) { %>
            <p class="form-error" role="alert"><%= error %></p>
          <% } %>
          <button type="submit" class="primary">Sign in</button>
        </form>
      </section>
    </main>
  </body>
</html>
