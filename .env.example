PORT=9000
HOST=0.0.0.0
NODE_ENV=development
STORAGE_PROVIDER=file
APP_NAME=Kinetriq IDC
# Relative paths are resolved from the project root (where package.json lives).
# Use an absolute path in production to avoid CWD-related issues.
# Example absolute: DATA_FILE=/var/data/kinetriq/tasks.json
DATA_FILE=./data/tasks.json
AZURE_LOCATION=Central India
SQL_ADMIN_LOGIN=
SQL_ADMIN_PASSWORD=

# Switch STORAGE_PROVIDER to mssql for Azure SQL persistence.
DB_SERVER=
DB_PORT=1433
DB_NAME=techzickplanner
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
